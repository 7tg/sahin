.local/
.deps/
.env
__pycache__/
*.pyc
build/
dist/
**/bin/
**/obj/
.vs/
.idea/
*.user
*.suo
*.log
*.elf
*.self
*.sprx
*.prx
*.pkg

# Home-screen art is local only (EA's emblem): tools/blackbox-assets.sh copies it in.
/sce_sys/icon0.png
/sce_sys/pic0.dds
/sce_sys/pic1.dds
/sce_sys/snd0.at9
/assets/games/
/assets/logo.png

# What a dev build carries to install on its own (nfs-blackbox-ps5: tools/make-bundle.py):
# repo-made sources and the bare prefix, never committed.
/assets/bundle/

# macOS folder metadata, and what libFuzzer leaves in the working folder (tools/store-test.sh).
.DS_Store
/slow-unit-*
/crash-*
/leak-*
/timeout-*
/oom-*

# A game app's art, copied in by tools/blackbox-assets.sh (local only, like the store's).
/games/*/sce_sys/icon0.png
/games/*/sce_sys/pic0.dds
/games/*/sce_sys/pic1.dds
/games/*/sce_sys/snd0.at9
