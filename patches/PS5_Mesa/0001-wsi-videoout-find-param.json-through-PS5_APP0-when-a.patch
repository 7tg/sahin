From 2318c5aca2e9b6e85f010e0486573862bc241bfc Mon Sep 17 00:00:00 2001
From: lavavex <27239435+lavavex@users.noreply.github.com>
Date: Wed, 7 Oct 2026 19:21:35 -0500
Subject: [PATCH 1/3] wsi/videoout: find param.json through PS5_APP0 when /app0
 is gone

A title granted /data no longer sees /app0, so the high-frame-rate check
could not read sce_sys/param.json and always presented at 59.94 Hz.
prospero-win exports the path it sees its files at as PS5_APP0.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01A9xZzd6eUvy4WLFbfGr4Yi
---
 src/vulkan/wsi/wsi_common_videoout.c | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/src/vulkan/wsi/wsi_common_videoout.c b/src/vulkan/wsi/wsi_common_videoout.c
index 7c61b644574..308c9773258 100644
--- a/src/vulkan/wsi/wsi_common_videoout.c
+++ b/src/vulkan/wsi/wsi_common_videoout.c
@@ -313,9 +313,19 @@ struct wsi_videoout {
 static bool
 videoout_title_declares_high_frame_rate(void)
 {
-   FILE *const file = fopen("/app0/sce_sys/param.json", "rb");
-   if (file == NULL)
+   FILE *file = fopen("/app0/sce_sys/param.json", "rb");
+   /* A title granted /data no longer sees /app0; prospero-win names the
+    * path it sees its files at instead. */
+   const char *const app0 = getenv("PS5_APP0");
+   if (file == NULL && app0 != NULL) {
+      char path[512];
+      snprintf(path, sizeof(path), "%s/sce_sys/param.json", app0);
+      file = fopen(path, "rb");
+   }
+   if (file == NULL) {
+      fprintf(stderr, "wsi/videoout: no sce_sys/param.json; presenting at 59.94 Hz\n");
       return false;
+   }
    char text[16384];
    const size_t length = fread(text, 1, sizeof(text) - 1, file);
    fclose(file);
-- 
