From 5fc179082c7f32c45d88f2be248aed38e2b50b56 Mon Sep 17 00:00:00 2001
From: lavavex <27239435+lavavex@users.noreply.github.com>
Date: Mon, 12 Oct 2026 00:00:00 +0000
Subject: [PATCH 2/2] radv/psbc link: PS5_CLANG_BUILTINS for a clang without
 x86-64 builtins

Homebrew's LLVM on macOS has the x86_64-sie-ps5 target but no x86-64
Linux builtins archive; the link takes one from PS5_CLANG_BUILTINS when
set. Unchanged otherwise.
---
 tools/psbc-link.sh | 4 +++-
 tools/radv-link.sh | 4 +++-
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/tools/psbc-link.sh b/tools/psbc-link.sh
index 6de6c44..da49447 100644
--- a/tools/psbc-link.sh
+++ b/tools/psbc-link.sh
@@ -26,7 +26,9 @@ psbc_link_recipe() {
     local compiler=${PS5_CLANG:-$(command -v clang || command -v clang-18 || true)}
     [[ -n $compiler ]] || { echo "clang was not found; set PS5_CLANG" >&2; return 2; }
     local builtins
-    builtins="$("$compiler" --print-resource-dir)/lib/linux/libclang_rt.builtins-x86_64.a"
+    # PS5_CLANG_BUILTINS: an x86-64 builtins archive for a clang that ships none for this
+    # target (Homebrew's LLVM on macOS).
+    builtins=${PS5_CLANG_BUILTINS:-"$("$compiler" --print-resource-dir)/lib/linux/libclang_rt.builtins-x86_64.a"}
 
     psbc_include=(-I "$psbc/include")
     psbc_linker_script=(-T "$root/tooling/psbc/ps5-pie-unwind.ld" -L "$root/tooling/native")
diff --git a/tools/radv-link.sh b/tools/radv-link.sh
index 413e24b..9b55598 100644
--- a/tools/radv-link.sh
+++ b/tools/radv-link.sh
@@ -22,7 +22,9 @@ radv_link_recipe() {
     local compiler=${PS5_CLANG:-$(command -v clang || command -v clang-18 || true)}
     [[ -n $compiler ]] || { echo "clang was not found; set PS5_CLANG" >&2; return 2; }
     local builtins
-    builtins="$("$compiler" --print-resource-dir)/lib/linux/libclang_rt.builtins-x86_64.a"
+    # PS5_CLANG_BUILTINS: an x86-64 builtins archive for a clang that ships none for this
+    # target (Homebrew's LLVM on macOS).
+    builtins=${PS5_CLANG_BUILTINS:-"$("$compiler" --print-resource-dir)/lib/linux/libclang_rt.builtins-x86_64.a"}
     local platform="$sdk_root/target/lib/libps5platform.a"
 
     radv_linker_script=(-T "$root/tooling/psbc/ps5-pie-unwind.ld" -L "$root/tooling/native")
-- 
