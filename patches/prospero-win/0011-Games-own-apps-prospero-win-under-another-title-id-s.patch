From b2fb4f7fa347d212fe239ff88f4ed3c6f022363b Mon Sep 17 00:00:00 2001
From: lavavex <27239435+lavavex@users.noreply.github.com>
Date: Sat, 10 Oct 2026 19:38:27 -0500
Subject: [PATCH 11/24] Games' own apps: prospero-win under another title id,
 starting one game

A tile that hands over to PPSA99995 works but shows the switch. A game's
own app is the whole title under its own id and icon: started from Home
with no arguments it runs PW_AUTOSTART_PROFILE with home=1 (no launcher)
and closes to Home when the game ends.

build_native.sh takes PW_TITLE_ID, PW_AUTOSTART_PROFILE and PW_LAPY_DIR (a
locally built Lapy helper, still checked against the title, protocol and
ELF digests); defaults are unchanged. tools/build_game_app.sh builds the
helper for the app's id from PS5-Lapy-JB-Daemon v0.3.2-experimental
(b48b7d7; a helper only elevates its TARGET_TITLE), the eboot, and the app
folder from the PPSA99995 package.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 native/wine64_main.c    | 21 ++++++++++
 tools/build_game_app.sh | 86 +++++++++++++++++++++++++++++++++++++++++
 tools/build_native.sh   | 18 ++++++++-
 3 files changed, 123 insertions(+), 2 deletions(-)
 create mode 100755 tools/build_game_app.sh

diff --git a/native/wine64_main.c b/native/wine64_main.c
index 04e28d5..67938cc 100644
--- a/native/wine64_main.c
+++ b/native/wine64_main.c
@@ -56,7 +56,17 @@
 #include <time.h>
 #include <unistd.h>
 
+/* The title this eboot is built for (tools/build_native.sh, PW_TITLE_ID):
+ * PPSA99995 is prospero-win itself; a game's own app (tools/build_game_app.sh)
+ * has its own id, Lapy helper and sandbox path. */
+#ifndef PW_TITLE_ID
 #define PW_TITLE_ID "PPSA99995"
+#endif
+/* A game's own app starts that profile when the system starts it with no
+ * game, and closes to Home when the game ends; empty for prospero-win. */
+#ifndef PW_AUTOSTART_PROFILE
+#define PW_AUTOSTART_PROFILE ""
+#endif
 #define PW_APP_NAME "prospero-win-wine64"
 
 /* Where the title's Wine runtime can be seen: /app0 inside the sandbox;
@@ -973,6 +983,17 @@ int main(int argc, char **argv)
         return 1;
     }
     (void)pw_wine_launch_parse(argc, argv, catalog, catalog_count, &launch);
+    static const char autostart_profile[] = PW_AUTOSTART_PROFILE;
+    if (launch.mode != PW_WINE_LAUNCH_GAME && !launch.refused && autostart_profile[0] != '\0') {
+        static char autostart_word[] = "profile=" PW_AUTOSTART_PROFILE;
+        static char home_word[] = "home=1";
+        char *autostart[] = { autostart_word, home_word };
+        uint32_t cycle = launch.cycle;
+        (void)pw_wine_launch_parse(2, autostart, catalog, catalog_count, &launch);
+        launch.cycle = cycle;
+        PS5LOG_LOG("PW_WINE64 autostart profile=%s mode=%s", PW_AUTOSTART_PROFILE,
