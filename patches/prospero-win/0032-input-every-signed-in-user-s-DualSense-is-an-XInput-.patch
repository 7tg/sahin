+/* The other signed-in users' pads: opened in sign-in order, kept in their
+ * slot, closed when the user signs out; the title's own user is never one. */
+static void test_players(void)
+{
+    PwPadPs5 main_pad;PwPadPlayers players;
+    assert(pw_pad_ps5_open(&main_pad,&ops,map,1)==PW_OK);
+    pw_pad_players_init(&players);
+    assert(pw_pad_players_scan(&players,&main_pad)==0 && !players.slot[0].opened);
+    memcpy(logged_in,(int32_t[4]){5,42,9,-1},sizeof(logged_in));
+    assert(pw_pad_players_scan(&players,&main_pad)==2);
+    assert(players.slot[0].opened && players.slot[0].user_id==5 && players.slot[0].pad_handle==105);
+    assert(players.slot[1].opened && players.slot[1].user_id==9 && !players.slot[2].opened);
+    assert(!players.slot[0].owns_user_service);
+    int opens=open_calls;
+    assert(pw_pad_players_scan(&players,&main_pad)==2 && open_calls==opens);  /* already open */
+    /* 5 signs out: 9 keeps slot 1, a new user takes the free slot 0. */
+    memcpy(logged_in,(int32_t[4]){42,9,-1,-1},sizeof(logged_in));
+    assert(pw_pad_players_scan(&players,&main_pad)==1 && !players.slot[0].opened &&
+           closed_count==1 && closed_handles[0]==105 && players.slot[1].user_id==9);
+    memcpy(logged_in,(int32_t[4]){42,9,3,-1},sizeof(logged_in));
+    assert(pw_pad_players_scan(&players,&main_pad)==2 && players.slot[0].user_id==3);
+    /* Reads: a connected pad's state, as for the title's own. */
+    other[0]=(PwPadPs5Data){.buttons=0x4000,.left_stick={1,2},.connected=1,.timestamp=10,.connected_count=1};
+    other_count=1;
+    assert(pw_pad_ps5_read(&players.slot[1])==PW_OK && players.slot[1].core.connected &&
+           players.slot[1].core.previous_buttons==0x4000 && players.slot[1].left_stick.x==1);
+    other_count=0;
+    /* A failed sign-in list changes nothing; no list op, no players. */
+    login_rc=-1;assert(pw_pad_players_scan(&players,&main_pad)==2);login_rc=0;
+    PwPadPs5 bare=main_pad;bare.ops.login_users=NULL;
+    PwPadPlayers none;pw_pad_players_init(&none);
+    assert(pw_pad_players_scan(&none,&bare)==0);
+    pw_pad_players_close(&players);
+    assert(!players.slot[0].opened && !players.slot[1].opened && closed_count==3);
+    memcpy(logged_in,(int32_t[4]){42,-1,-1,-1},sizeof(logged_in));
+    assert(pw_pad_ps5_close(&main_pad)==PW_OK);
+    open_calls=close_calls=terminate_calls=init_calls=foreground_calls=pad_init_calls=0;
+}
 int main(void)
 {
