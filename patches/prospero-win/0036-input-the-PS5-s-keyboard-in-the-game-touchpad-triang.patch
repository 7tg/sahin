@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_TEXT_KEYS_H
+#define PW_TEXT_KEYS_H
+/*
+ * Text typed as key presses: what the player confirmed in the system
+ * keyboard (UTF-16, as the dialog returns it) becomes the virtual keys a
+ * US keyboard would send for it, Shift around a capital or a shifted
+ * symbol. Wine's layout in the prefix maps them back to the characters, and
+ * a game reading DirectInput's scan codes sees them as well. Characters a US
+ * keyboard has no key for are skipped and counted.
+ */
+#include "pw_hid.h"
+#include <stddef.h>
+#include <stdint.h>
+
+/* The key that types c and whether it needs Shift; 0 when there is none
+ * (printable ASCII only). */
+int pw_text_key(uint32_t c, uint8_t *vk, int *shift);
+
+/* Up to length units of text, ending at a NUL, as key events: Shift down,
+ * key down, key up, Shift up for each character. Whole characters only, so
+ * a buffer too small ends at the last one that fits. Returns how many events
+ * were written; *skipped (when given) counts the characters with no key. */
+size_t pw_text_keys(const uint16_t *text, size_t length, PwHidEvent *out, size_t capacity,
+                    size_t *skipped);
+#endif
diff --git a/tests/test_pw_ime_chord.c b/tests/test_pw_ime_chord.c
new file mode 100644
index 0000000..fea21d8
--- /dev/null
+++ b/tests/test_pw_ime_chord.c
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "../src/pw_ime_chord.h"
+#include <assert.h>
+#include <stdio.h>
+
+enum { T = PW_IME_CHORD_TRIANGLE, P = PW_IME_CHORD_TOUCHPAD, X = 0x4000u };
+
+static void test_chord(void)
+{
+    PwImeChord c = { 0 };
+    int open;
+
+    /* △ alone: no keyboard, nothing withheld. */
+    assert(pw_ime_chord_step(&c, T, T, &open) == 0 && !open);
+    assert(pw_ime_chord_step(&c, 0, 0, &open) == 0 && !open);
+
+    /* Touchpad held, then △: the keyboard opens once, △ is withheld while held. */
+    assert(pw_ime_chord_step(&c, P, P, &open) == 0 && !open);
+    assert(pw_ime_chord_step(&c, P | T, T, &open) == T && open);
+    assert(pw_ime_chord_step(&c, P | T, 0, &open) == T && !open);
+    /* The touchpad let go first: △ stays withheld until its own release. */
+    assert(pw_ime_chord_step(&c, T | X, X, &open) == T && !open);
+    assert(pw_ime_chord_step(&c, X, 0, &open) == T && !open);    /* the release frame */
+    assert(pw_ime_chord_step(&c, X, 0, &open) == 0 && !open);
+
+    /* Pressed and released in one batch: opens, withheld that frame only. */
+    assert(pw_ime_chord_step(&c, P, T, &open) == T && open);
+    assert(pw_ime_chord_step(&c, P, 0, &open) == 0 && !open);
+
+    /* Both in the same batch count as the chord. */
+    assert(pw_ime_chord_step(&c, P | T, P | T, &open) == T && open);
+    assert(pw_ime_chord_step(&c, 0, 0, &open) == T && !open);
+    assert(pw_ime_chord_step(&c, 0, 0, &open) == 0 && !open);
+}
+
+int main(void)
+{
+    test_chord();
+    puts("test_pw_ime_chord: ok");
+    return 0;
+}
diff --git a/tests/test_pw_text_keys.c b/tests/test_pw_text_keys.c
new file mode 100644
index 0000000..06d82fe
--- /dev/null
+++ b/tests/test_pw_text_keys.c
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "../src/pw_text_keys.h"
+#include <assert.h>
+#include <stdio.h>
+
+static void test_key(void)
+{
+    uint8_t vk;
+    int shift;
+
+    assert(pw_text_key('a', &vk, &shift) && vk == 'A' && !shift);
+    assert(pw_text_key('Z', &vk, &shift) && vk == 'Z' && shift);
+    assert(pw_text_key('7', &vk, &shift) && vk == '7' && !shift);
+    assert(pw_text_key(' ', &vk, &shift) && vk == 0x20 && !shift);
+    assert(pw_text_key('@', &vk, &shift) && vk == '2' && shift);
+    assert(pw_text_key(')', &vk, &shift) && vk == '0' && shift);
+    assert(pw_text_key('-', &vk, &shift) && vk == 0xbd && !shift);
+    assert(pw_text_key('_', &vk, &shift) && vk == 0xbd && shift);
+    assert(pw_text_key('=', &vk, &shift) && vk == 0xbb && !shift);
+    assert(pw_text_key('+', &vk, &shift) && vk == 0xbb && shift);
+    assert(pw_text_key('[', &vk, &shift) && vk == 0xdb && !shift);
+    assert(pw_text_key('}', &vk, &shift) && vk == 0xdd && shift);
+    assert(pw_text_key('\\', &vk, &shift) && vk == 0xdc && !shift);
+    assert(pw_text_key('|', &vk, &shift) && vk == 0xdc && shift);
+    assert(pw_text_key(';', &vk, &shift) && vk == 0xba && !shift);
+    assert(pw_text_key(':', &vk, &shift) && vk == 0xba && shift);
+    assert(pw_text_key('\'', &vk, &shift) && vk == 0xde && !shift);
+    assert(pw_text_key('"', &vk, &shift) && vk == 0xde && shift);
+    assert(pw_text_key(',', &vk, &shift) && vk == 0xbc && !shift);
+    assert(pw_text_key('<', &vk, &shift) && vk == 0xbc && shift);
+    assert(pw_text_key('.', &vk, &shift) && vk == 0xbe && !shift);
+    assert(pw_text_key('>', &vk, &shift) && vk == 0xbe && shift);
+    assert(pw_text_key('/', &vk, &shift) && vk == 0xbf && !shift);
+    assert(pw_text_key('?', &vk, &shift) && vk == 0xbf && shift);
+    assert(pw_text_key('`', &vk, &shift) && vk == 0xc0 && !shift);
+    assert(pw_text_key('~', &vk, &shift) && vk == 0xc0 && shift);
+    /* Every printable ASCII character has a key. */
+    for (uint32_t c = 0x20; c < 0x7f; c++) assert(pw_text_key(c, &vk, &shift));
+    /* No key: control characters, DEL, anything past ASCII. */
+    assert(!pw_text_key('\n', &vk, &shift) && !pw_text_key(0x7f, &vk, &shift));
+    assert(!pw_text_key(0xe7, &vk, &shift) && !pw_text_key(0x131, &vk, &shift));
+}
+
+static int is(const PwHidEvent *e, uint16_t code, int down)
+{
+    return e->kind == PW_HID_EVENT_KEY && e->code == code && e->down == down;
+}
+
+static void test_keys(void)
+{
+    static const uint16_t text[] = { 'a', 'B', '!' };
+    static const uint16_t foreign[] = { 0xe7, 'x', 0xd83d, 0xde00, 0xdc00, 'y' };   /* ç x 😀 lone-low y */
+    PwHidEvent e[32];
+    size_t skipped = 9, n;
+
+    n = pw_text_keys(text, 3, e, 32, &skipped);
+    assert(n == 10 && skipped == 0);
+    assert(is(&e[0], 'A', 1) && is(&e[1], 'A', 0));
+    assert(is(&e[2], 0x10, 1) && is(&e[3], 'B', 1) && is(&e[4], 'B', 0) && is(&e[5], 0x10, 0));
+    assert(is(&e[6], 0x10, 1) && is(&e[7], '1', 1) && is(&e[8], '1', 0) && is(&e[9], 0x10, 0));
+
+    /* Unmapped characters are counted, a surrogate pair as one. */
+    n = pw_text_keys(foreign, 6, e, 32, &skipped);
+    assert(n == 4 && skipped == 3);
+    assert(is(&e[0], 'X', 1) && is(&e[1], 'X', 0) && is(&e[2], 'Y', 1) && is(&e[3], 'Y', 0));
+
+    /* Only whole characters: 5 slots hold "a" and not the shifted "B". */
+    n = pw_text_keys(text, 3, e, 5, &skipped);
+    assert(n == 2);
+
+    /* The text ends at its first NUL; empty text and no buffer type nothing. */
+    {
+        static const uint16_t cut[] = { 'q', 0, 'w' };
+        n = pw_text_keys(cut, 3, e, 32, &skipped);
+        assert(n == 2 && is(&e[0], 'Q', 1));
+    }
+    assert(pw_text_keys(text, 0, e, 32, &skipped) == 0);
+    assert(pw_text_keys(text, 3, NULL, 32, NULL) == 0);
+}
+
+int main(void)
+{
+    test_key();
+    test_keys();
+    puts("test_pw_text_keys: ok");
+    return 0;
+}
