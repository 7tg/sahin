diff --git a/native/pw_ime_ps5.c b/native/pw_ime_ps5.c
new file mode 100644
index 0000000..d09b486
--- /dev/null
+++ b/native/pw_ime_ps5.c
@@ -0,0 +1,99 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "pw_ime_ps5.h"
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef struct ImeParam {
+    int32_t user_id, type;
+    uint64_t supported_languages;
+    int32_t enter_label, input_method;
+    void *filter;
+    uint32_t option, max_text_length;
+    uint16_t *input_text_buffer;
+    float pos_x, pos_y;
+    int32_t horizontal_alignment, vertical_alignment;
+    const uint16_t *placeholder, *title;
+    int8_t reserved[16];
+} ImeParam;
+typedef struct ImeResult {
+    int32_t outcome;
+    int8_t reserved[12];
+} ImeResult;
+_Static_assert(sizeof(ImeParam) == 96, "sceImeDialogInit's parameter");
+_Static_assert(offsetof(ImeParam, input_text_buffer) == 40, "sceImeDialogInit's parameter");
+_Static_assert(offsetof(ImeParam, title) == 72, "sceImeDialogInit's parameter");
+_Static_assert(sizeof(ImeResult) == 16, "sceImeDialogGetResult's result");
+
+int sceSysmoduleLoadModule(uint16_t id);
+int sceCommonDialogInitialize(void);
+int sceImeDialogInit(const ImeParam *param, const void *extended);
+int sceImeDialogGetStatus(void);
+int sceImeDialogGetResult(ImeResult *result);
+int sceImeDialogTerm(void);
+
+enum { IME_MODULE = 0x0096, STATUS_RUNNING = 1, STATUS_FINISHED = 2 };
+/* Common dialogs already initialised (by this process, earlier). */
+#define COMMON_DIALOG_ALREADY 0x80b80002u
+
+static const uint16_t title[] = { 'S', 'a', 'h', 'i', 'n', 0 };
+static const uint16_t placeholder[] = { 0 };
+
+void pw_ime_ps5_preload(void (*log)(const char *line))
+{
+    char line[96];
+    int module = sceSysmoduleLoadModule(IME_MODULE);
+    int dialogs = sceCommonDialogInitialize();
+
+    snprintf(line, sizeof(line), "preload libSceImeDialog id=%#x status=%#x common_dialog=%#x",
+             (unsigned)IME_MODULE, (unsigned)module, (unsigned)dialogs);
+    if (log) log(line);
+}
+
+int pw_ime_ps5_open(PwImePs5 *ime, int32_t user_id, uint64_t now_ns)
+{
+    ImeParam param;
+    int dialogs, status;
+
+    if (!ime || ime->active) return -1;
+    dialogs = sceCommonDialogInitialize();
+    if (dialogs < 0 && (uint32_t)dialogs != COMMON_DIALOG_ALREADY) return dialogs;
+    memset(&param, 0, sizeof(param));
+    memset(ime->text, 0, sizeof(ime->text));
+    param.user_id = user_id;
+    param.max_text_length = PW_IME_PS5_TEXT;
+    param.input_text_buffer = ime->text;
+    param.horizontal_alignment = param.vertical_alignment = 1;
+    param.placeholder = placeholder;
+    param.title = title;
+    status = sceImeDialogInit(&param, NULL);
+    if (status != 0) return status;
+    ime->active = 1;
+    ime->opened_ns = now_ns;
+    return 0;
+}
+
+PwImePs5State pw_ime_ps5_poll(PwImePs5 *ime, uint64_t now_ns)
+{
+    PwImePs5State state = PW_IME_PS5_FAILED;
+    int status;
+
+    if (!ime || !ime->active) return PW_IME_PS5_IDLE;
+    status = sceImeDialogGetStatus();
+    /* The status reads 0 for a moment after the init (measured by the
+     * store launcher): still showing. */
+    if (status == STATUS_RUNNING || (status == 0 && now_ns - ime->opened_ns < 1000000000u))
+        return PW_IME_PS5_SHOWING;
+    if (status == STATUS_FINISHED) {
+        ImeResult result;
+
+        memset(&result, 0, sizeof(result));
+        if (sceImeDialogGetResult(&result) >= 0)
+            state = result.outcome == 0 ? PW_IME_PS5_ACCEPTED : PW_IME_PS5_CANCELLED;
+    }
+    /* The system may still own the dialog; ask again next frame. */
+    if (sceImeDialogTerm() < 0) return PW_IME_PS5_SHOWING;
+    ime->active = 0;
+    if (state != PW_IME_PS5_ACCEPTED) memset(ime->text, 0, sizeof(ime->text));
+    return state;
+}
