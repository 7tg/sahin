diff --git a/src/pw_ime_chord.c b/src/pw_ime_chord.c
new file mode 100644
index 0000000..3ae34b7
--- /dev/null
+++ b/src/pw_ime_chord.c
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "pw_ime_chord.h"
+
+uint32_t pw_ime_chord_step(PwImeChord *chord, uint32_t held, uint32_t pressed, int *open)
+{
+    uint32_t withhold;
+    int made = (pressed & PW_IME_CHORD_TRIANGLE) && (held & PW_IME_CHORD_TOUCHPAD);
+
+    if (open) *open = made;
+    if (!chord) return 0;
+    if (made) chord->withholding = 1;
+    withhold = chord->withholding ? PW_IME_CHORD_TRIANGLE : 0;
+    /* △'s release is withheld too, then it is the game's again. */
+    if (!(held & PW_IME_CHORD_TRIANGLE)) chord->withholding = 0;
+    return withhold;
+}
diff --git a/src/pw_ime_chord.h b/src/pw_ime_chord.h
new file mode 100644
index 0000000..d47ebe8
--- /dev/null
+++ b/src/pw_ime_chord.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_IME_CHORD_H
+#define PW_IME_CHORD_H
+/*
+ * The system keyboard's chord: △ pressed while the touchpad is held opens
+ * it. From that press until △ is released, △ is withheld from the game
+ * (its XInput Y and any binding), so the chord doesn't also act in it.
+ */
+#include <stdint.h>
+
+enum { PW_IME_CHORD_TRIANGLE = 0x1000u, PW_IME_CHORD_TOUCHPAD = 0x100000u };
+
+typedef struct PwImeChord {
+    int withholding;    /* △ belongs to the chord until its release */
+} PwImeChord;
+
+/* One pad batch: the buttons held after it and the ones pressed in it.
+ * *open is 1 on the batch the chord is made; returns the DualSense buttons
+ * to withhold from the game in this batch. */
+uint32_t pw_ime_chord_step(PwImeChord *chord, uint32_t held, uint32_t pressed, int *open);
+#endif
diff --git a/src/pw_text_keys.c b/src/pw_text_keys.c
new file mode 100644
index 0000000..8c779e2
--- /dev/null
+++ b/src/pw_text_keys.c
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "pw_text_keys.h"
+
+enum { VK_SHIFT = 0x10 };
+
+/* The US layout's punctuation: unshifted, shifted, and their key. */
+static const struct { char plain, shifted; uint8_t vk; } symbols[] = {
+    { '-', '_', 0xbd }, { '=', '+', 0xbb }, { '[', '{', 0xdb }, { ']', '}', 0xdd },
+    { '\\', '|', 0xdc }, { ';', ':', 0xba }, { '\'', '"', 0xde }, { ',', '<', 0xbc },
+    { '.', '>', 0xbe }, { '/', '?', 0xbf }, { '`', '~', 0xc0 },
+};
+/* The digit row's shifted characters, from 0 to 9. */
+static const char digit_shifted[] = ")!@#$%^&*(";
+
+int pw_text_key(uint32_t c, uint8_t *vk, int *shift)
+{
+    uint8_t key = 0;
+    int shifted = 0;
+
+    if (c >= 'a' && c <= 'z') key = (uint8_t)(c - 'a' + 'A');
+    else if (c >= 'A' && c <= 'Z') key = (uint8_t)c, shifted = 1;
+    else if (c >= '0' && c <= '9') key = (uint8_t)c;
+    else if (c == ' ') key = 0x20;
+    else if (c > ' ' && c < 0x7f) {
+        for (unsigned i = 0; !key && i < 10; i++)
+            if ((uint32_t)(unsigned char)digit_shifted[i] == c) key = (uint8_t)('0' + i), shifted = 1;
+        for (size_t i = 0; !key && i < sizeof(symbols) / sizeof(symbols[0]); i++) {
+            if ((uint32_t)(unsigned char)symbols[i].plain == c) key = symbols[i].vk;
+            else if ((uint32_t)(unsigned char)symbols[i].shifted == c) key = symbols[i].vk, shifted = 1;
+        }
+    }
+    if (!key) return 0;
+    if (vk) *vk = key;
+    if (shift) *shift = shifted;
+    return 1;
+}
+
+size_t pw_text_keys(const uint16_t *text, size_t length, PwHidEvent *out, size_t capacity,
+                    size_t *skipped)
+{
+    size_t count = 0, missing = 0;
+
+    if (skipped) *skipped = 0;
+    if (!text || !out) return 0;
+    for (size_t i = 0; i < length && text[i]; i++) {
+        uint8_t vk;
+        int shift;
+
+        if (!pw_text_key(text[i], &vk, &shift)) {
+            /* A surrogate pair is one character. */
+            if (text[i] >= 0xd800 && text[i] <= 0xdbff && i + 1 < length &&
+                text[i + 1] >= 0xdc00 && text[i + 1] <= 0xdfff)
+                i++;
+            missing++;
+            continue;
+        }
+        if (count + (shift ? 4u : 2u) > capacity) break;
+        if (shift) out[count++] = (PwHidEvent){ PW_HID_EVENT_KEY, 1, VK_SHIFT };
+        out[count++] = (PwHidEvent){ PW_HID_EVENT_KEY, 1, vk };
+        out[count++] = (PwHidEvent){ PW_HID_EVENT_KEY, 0, vk };
+        if (shift) out[count++] = (PwHidEvent){ PW_HID_EVENT_KEY, 0, VK_SHIFT };
+    }
+    if (skipped) *skipped = missing;
+    return count;
+}
diff --git a/src/pw_text_keys.h b/src/pw_text_keys.h
