+++ b/native/pw_ime_ps5.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_IME_PS5_H
+#define PW_IME_PS5_H
+/*
+ * The PS5's own keyboard (libSceImeDialog), over the game: opened by the
+ * pad's chord (src/pw_ime_chord.h) and polled once a frame, never waited
+ * for. The system loads the module (sceSysmoduleLoadModule 0x96, as the
+ * keyboard and mouse modules: a title may not load them by path) and owns
+ * the pad while the dialog shows. The parameter layout is the one
+ * ProsperoRadio's keyboard and the store launcher use on hardware:
+ *
+ *   param, 96 bytes: s32 user, type; u64 languages; s32 enter label,
+ *     input method; void *filter; u32 option, max length; u16 *text;
+ *     f32 x, y; s32 horizontal, vertical alignment; u16 *placeholder,
+ *     *title; 16 reserved bytes
+ *   result, 16 bytes: s32 outcome (0 accepted); 12 reserved bytes
+ */
+#include <stdint.h>
+
+enum { PW_IME_PS5_TEXT = 64 };   /* characters the player may type */
+
+typedef enum PwImePs5State {
+    PW_IME_PS5_IDLE = 0, PW_IME_PS5_SHOWING, PW_IME_PS5_ACCEPTED, PW_IME_PS5_CANCELLED,
+    PW_IME_PS5_FAILED,
+} PwImePs5State;
+
+typedef struct PwImePs5 {
+    int active;
+    uint64_t opened_ns;
+    uint16_t text[PW_IME_PS5_TEXT + 1];   /* UTF-16, NUL-terminated: what was accepted */
+} PwImePs5;
+
+/* Loads the module and readies the common dialogs early, with the
+ * keyboard and mouse modules (pw_hid_ps5_preload); logs both results. */
+void pw_ime_ps5_preload(void (*log)(const char *line));
+/* Shows an empty keyboard for user_id; 0, or the system's error. */
+int pw_ime_ps5_open(PwImePs5 *ime, int32_t user_id, uint64_t now_ns);
+/* SHOWING while the player types; then ACCEPTED (text in ime->text),
+ * CANCELLED or FAILED once, and IDLE after. */
+PwImePs5State pw_ime_ps5_poll(PwImePs5 *ime, uint64_t now_ns);
+#endif
