diff --git a/src/pw_wine_launch.h b/src/pw_wine_launch.h
index 62607b2..144ab2d 100644
--- a/src/pw_wine_launch.h
+++ b/src/pw_wine_launch.h
@@ -10,7 +10,11 @@
