--- /dev/null
+++ b/wine/patches/0480-iphlpapi-ps5-title-network-adapter.patch
@@ -0,0 +1,119 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: prospero-win <prospero-win@invalid>
+Date: Thu, 22 Oct 2026 12:00:00 +0300
+Subject: [PATCH] iphlpapi: Report the PS5 title's network adapter.
+
+A PS5 title runs Wine in its own process and cannot start winedevice, so
+nsiproxy.sys never answers and every NSI table fails. GetAdaptersInfo
+then reported no adapter, and games that look for one before going
+online (Blur's Demonware client) said the server was unavailable without
+connecting.
+
+When the NDIS table fails, GetAdaptersInfo now reads WINE_PS5_ADAPTER,
+which the title sets from the console's network (sceNetCtlGetInfo) as
+"ip,netmask,gateway,mac" with the MAC as 12 hex digits, and reports that
+one Ethernet adapter. Without the variable, as anywhere but in a title,
+the NSI error is returned as before.
+---
+ dlls/iphlpapi/iphlpapi_main.c |   79 +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++-
+ 1 file changed, 78 insertions(+), 1 deletion(-)
+
+diff --git a/dlls/iphlpapi/iphlpapi_main.c b/dlls/iphlpapi/iphlpapi_main.c
+index b315490..78a9880 100644
+--- a/dlls/iphlpapi/iphlpapi_main.c
++++ b/dlls/iphlpapi/iphlpapi_main.c
+@@ -585,6 +585,79 @@ static void ip_addr_string_init( IP_ADDR_STRING *s, const IN_ADDR *addr, const I
+     s->Context = ctxt;
+ }
+ 
++/* A PS5 title cannot start winedevice, so nsiproxy.sys never answers and
++ * every NSI table fails. The title reads the console's network
++ * (sceNetCtlGetInfo) and passes it as WINE_PS5_ADAPTER =
++ * "ip,netmask,gateway,mac", the MAC as 12 hex digits; GetAdaptersInfo
++ * then reports that one Ethernet adapter. Without the variable, as
++ * anywhere but in a title, nothing changes. */
++static BOOL ps5_adapter( IN_ADDR *addr, IN_ADDR *mask, IN_ADDR *gateway, BYTE mac[6] )
++{
++    char value[96], *field[4], *cursor = value;
++    const char *end;
++    DWORD len, i;
++
++    len = GetEnvironmentVariableA( "WINE_PS5_ADAPTER", value, sizeof(value) );
++    if (!len || len >= sizeof(value)) return FALSE;
++    for (i = 0; i < 4; i++)
++    {
++        field[i] = cursor;
++        cursor = strchr( cursor, ',' );
++        if (i < 3)
++        {
++            if (!cursor) return FALSE;
++            *cursor++ = 0;
++        }
++        else if (cursor) return FALSE;
++    }
++    if (RtlIpv4StringToAddressA( field[0], TRUE, &end, addr ) || *end) return FALSE;
++    if (RtlIpv4StringToAddressA( field[1], TRUE, &end, mask ) || *end) return FALSE;
++    if (RtlIpv4StringToAddressA( field[2], TRUE, &end, gateway ) || *end) return FALSE;
++    if (strlen( field[3] ) != 12) return FALSE;
++    for (i = 0; i < 12; i++)
++    {
++        char c = field[3][i];
++        BYTE digit;
++
++        if (c >= '0' && c <= '9') digit = c - '0';
++        else if (c >= 'a' && c <= 'f') digit = c - 'a' + 10;
++        else if (c >= 'A' && c <= 'F') digit = c - 'A' + 10;
++        else return FALSE;
++        mac[i / 2] = i % 2 ? (mac[i / 2] << 4) | digit : digit;
++    }
++    return TRUE;
++}
++
++static DWORD ps5_adapters_info( IP_ADAPTER_INFO *info, ULONG *size )
++{
++    static const GUID guid = { 0x5053352d, 0x6e65, 0x7400, { 0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01 } };
++    IN_ADDR addr, mask, gateway, none;
++    BYTE mac[6];
++
++    if (!ps5_adapter( &addr, &mask, &gateway, mac )) return ERROR_NO_DATA;
++    if (!info || *size < sizeof(*info))
++    {
++        *size = sizeof(*info);
++        return ERROR_BUFFER_OVERFLOW;
++    }
++    memset( info, 0, sizeof(*info) );
++    ConvertGuidToStringA( &guid, info->AdapterName, sizeof(info->AdapterName) );
++    strcpy( info->Description, "PS5 network" );
++    info->AddressLength = sizeof(mac);
++    memcpy( info->Address, mac, sizeof(mac) );
++    info->Index = 1;
++    info->Type = MIB_IF_TYPE_ETHERNET;
++    info->DhcpEnabled = TRUE;
++    ip_addr_string_init( &info->IpAddressList, &addr, &mask, 0 );
++    none.s_addr = INADDR_NONE;
++    ip_addr_string_init( &info->GatewayList, &gateway, &none, 0 );
++    ip_addr_string_init( &info->DhcpServer, NULL, NULL, 0 );
++    ip_addr_string_init( &info->PrimaryWinsServer, NULL, NULL, 0 );
++    ip_addr_string_init( &info->SecondaryWinsServer, NULL, NULL, 0 );
++    TRACE( "PS5 adapter %s\n", info->IpAddressList.IpAddress.String );
++    return ERROR_SUCCESS;
++}
++
+ /******************************************************************
+  *    GetAdaptersInfo (IPHLPAPI.@)
+  *
+@@ -615,7 +688,11 @@ DWORD WINAPI GetAdaptersInfo( IP_ADAPTER_INFO *info, ULONG *size )
+                                   (void **)&if_keys, sizeof(*if_keys), (void **)&if_rw, sizeof(*if_rw),
+                                   NULL, 0, (void **)&if_stat, sizeof(*if_stat), &if_count, 0 );
+ 
+-    if (err) return err;
++    if (err)
++    {
++        DWORD ps5 = ps5_adapters_info( info, size );
++        return ps5 == ERROR_NO_DATA ? err : ps5;
++    }
+     for (i = 0; i < if_count; i++)
+     {
+         if (if_stat[i].type == IF_TYPE_SOFTWARE_LOOPBACK) continue;
+-- 
+2.47.0
-- 
2.56.0

