+## Network adapter
+
+Games ask `GetAdaptersInfo` for the machine's adapters, and some look for one
+before going online (Blur's Demonware client says the server is unavailable
+without connecting). Wine answers through NSI, served by `nsiproxy.sys` in
+`winedevice.exe`, which a title cannot start, so every NSI table fails and
+no adapter is found. Patch 0480 gives `GetAdaptersInfo` one:
+
+- The title reads the console's network with `sceNetCtlGetInfo` (Ethernet
+  address, IP address, netmask, default route; `native/pw_net_ps5.c`) and
+  sets `WINE_PS5_ADAPTER=ip,netmask,gateway,mac`, the MAC as 12 hex digits
+  (`src/pw_net_adapter.c`). The game log has a `PW_WINE64 net adapter` line.
+- When the NDIS table fails, `GetAdaptersInfo` reports that one Ethernet
+  adapter. Without the variable, as anywhere but in a title, the NSI error
+  is returned as before.
+- iphlpapi is in `PE_MODULES`, so the patched DLL replaces the host build's.
+
 ## WoW64 CPU backend
 
 The PRX stage also links `wowprospero.prx`, the Unix side of the WoW64 CPU
diff --git a/native/pw_net_ps5.c b/native/pw_net_ps5.c
new file mode 100644
index 0000000..e1794ce
--- /dev/null
+++ b/native/pw_net_ps5.c
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "pw_net_ps5.h"
+#include "../src/pw_net_adapter.h"
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+int sceNetCtlInit(void);
+int sceNetCtlGetInfo(int code, void *info);
+
+enum { INFO_ETHER_ADDR = 2, INFO_IP_ADDRESS = 14, INFO_NETMASK = 15, INFO_DEFAULT_ROUTE = 16,
+       INFO_BYTES = 512 /* the union is 256 bytes; room to spare */ };
+
+/* One string field; empty when the call fails. */
+static int text(int code, char out[16])
+{
+    union { char text[INFO_BYTES]; uint64_t align; } info;
+    int status;
+
+    memset(&info, 0, sizeof(info));
+    status = sceNetCtlGetInfo(code, &info);
+    memcpy(out, info.text, 15);
+    out[15] = 0;
+    if (status < 0) out[0] = 0;
+    return status;
+}
+
+int pw_net_ps5_adapter(char *out, size_t size, void (*log)(const char *line))
+{
+    union { uint8_t bytes[INFO_BYTES]; uint64_t align; } ether;
+    char ip[16], netmask[16], gateway[16], line[160];
+    int init, ether_status, ip_status, mask_status, route_status, status;
+
+    if (!out || !size) return PW_ERR_PRECONDITION;
+    out[0] = 0;
+    init = sceNetCtlInit();   /* already initialised is an error code; the reads tell */
+    memset(&ether, 0, sizeof(ether));
+    ether_status = sceNetCtlGetInfo(INFO_ETHER_ADDR, &ether);
+    ip_status = text(INFO_IP_ADDRESS, ip);
+    mask_status = text(INFO_NETMASK, netmask);
+    route_status = text(INFO_DEFAULT_ROUTE, gateway);
+    status = ether_status < 0 ? PW_ERR_NOT_FOUND :
+             pw_net_adapter_value(ip, netmask, gateway, ether.bytes, out, size);
+    snprintf(line, sizeof(line), "adapter init=%#x ether=%#x ip=%#x netmask=%#x route=%#x value=%s status=%d",
+             (unsigned)init, (unsigned)ether_status, (unsigned)ip_status, (unsigned)mask_status,
+             (unsigned)route_status, status == PW_OK ? out : "-", status);
+    if (log) log(line);
+    return status;
+}
