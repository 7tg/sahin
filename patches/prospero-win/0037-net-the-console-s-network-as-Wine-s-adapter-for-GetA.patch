+#ifndef PW_NET_PS5_H
+#define PW_NET_PS5_H
+/*
+ * The console's network for Wine's adapter (src/pw_net_adapter.h), read
+ * with libSceNetCtl: sceNetCtlGetInfo's codes and its info union are the
+ * ones public PS4/PS5 reimplementations agree on (OpenOrbis, shadPS4):
+ * 2 the Ethernet address (6 bytes), 14 the IP address, 15 the netmask,
+ * 16 the default route, each address a NUL-terminated string of 16 bytes.
+ */
+#include <stddef.h>
