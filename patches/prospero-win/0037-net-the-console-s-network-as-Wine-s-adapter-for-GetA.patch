diff --git a/src/pw_net_adapter.c b/src/pw_net_adapter.c
new file mode 100644
index 0000000..3b67783
--- /dev/null
+++ b/src/pw_net_adapter.c
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "pw_net_adapter.h"
+#include <stdio.h>
+#include <string.h>
+
+/* A dotted IPv4 address: four decimal parts of 0..255 without leading
+ * zeros. Its value goes to *value. */
+static int ipv4(const char *text, uint32_t *value)
+{
+    uint32_t address = 0;
+
+    for (int part = 0; part < 4; part++) {
+        unsigned number = 0, digits = 0;
+
+        while (*text >= '0' && *text <= '9') {
+            if (digits && !number) return 0;              /* a leading zero */
+            number = number * 10 + (unsigned)(*text++ - '0');
+            if (++digits > 3 || number > 255) return 0;
+        }
+        if (!digits) return 0;
+        address = address << 8 | number;
+        if (part < 3 && *text++ != '.') return 0;
+    }
+    if (*text) return 0;
+    *value = address;
+    return 1;
+}
+
+int pw_net_adapter_value(const char *ip, const char *netmask, const char *gateway, const uint8_t mac[6],
+                         char *out, size_t size)
+{
+    uint32_t value;
+    int written;
+
+    if (!ip || !netmask || !gateway || !mac || !out || !size) return PW_ERR_PRECONDITION;
+    if (!*gateway) gateway = "0.0.0.0";
+    if (!ipv4(ip, &value) || !value || !ipv4(netmask, &value) || !ipv4(gateway, &value))
+        return PW_ERR_MALFORMED;
+    written = snprintf(out, size, "%s,%s,%s,%02x%02x%02x%02x%02x%02x", ip, netmask, gateway, mac[0], mac[1],
+                       mac[2], mac[3], mac[4], mac[5]);
+    if (written < 0 || (size_t)written >= size) {
+        out[0] = 0;
+        return PW_ERR_PRECONDITION;
+    }
+    return PW_OK;
+}
diff --git a/src/pw_net_adapter.h b/src/pw_net_adapter.h
new file mode 100644
index 0000000..d4a630e
--- /dev/null
+++ b/src/pw_net_adapter.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef PW_NET_ADAPTER_H
+#define PW_NET_ADAPTER_H
+/*
+ * The console's network as Wine's one adapter. A title cannot start
+ * winedevice, so nsiproxy.sys never answers and Wine's GetAdaptersInfo
+ * found no adapter; games that look for one before going online gave up
+ * (Blur's Demonware client). The title reads the console's network and
+ * sets WINE_PS5_ADAPTER = "ip,netmask,gateway,mac", the MAC as 12 hex
+ * digits, which GetAdaptersInfo reports (Wine patch 0480).
+ */
+#include "../include/prospero_win.h"
+#include <stddef.h>
+#include <stdint.h>
+
+enum { PW_NET_ADAPTER_VALUE = 3 * 16 + 12 + 1 };   /* three addresses, the MAC, NUL */
+
+/* The variable's value. Each address is a dotted IPv4 address (no leading
+ * zeros); the address may not be 0.0.0.0, and an empty gateway (no default
+ * route) is 0.0.0.0. PW_ERR_MALFORMED for anything else, so only these
+ * characters reach Wine's environment. */
+int pw_net_adapter_value(const char *ip, const char *netmask, const char *gateway, const uint8_t mac[6],
+                         char *out, size_t size);
+#endif
diff --git a/tests/test_pw_net_adapter.c b/tests/test_pw_net_adapter.c
new file mode 100644
index 0000000..3db7b0f
--- /dev/null
+++ b/tests/test_pw_net_adapter.c
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "../src/pw_net_adapter.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static void test_value(void)
+{
+    static const uint8_t mac[6] = { 0x50, 0xb0, 0x3b, 0xf7, 0xe3, 0xa2 };
+    char out[PW_NET_ADAPTER_VALUE];
+
+    assert(pw_net_adapter_value("192.168.31.16", "255.255.255.0", "192.168.31.1", mac, out, sizeof(out)) == PW_OK);
+    assert(!strcmp(out, "192.168.31.16,255.255.255.0,192.168.31.1,50b03bf7e3a2"));
+
+    /* No default route: no gateway, the rest still reported. */
+    assert(pw_net_adapter_value("10.0.0.5", "255.0.0.0", "", mac, out, sizeof(out)) == PW_OK);
+    assert(!strcmp(out, "10.0.0.5,255.0.0.0,0.0.0.0,50b03bf7e3a2"));
+
+    /* Only dotted IPv4 addresses reach Wine's environment. */
+    assert(pw_net_adapter_value("", "255.255.255.0", "192.168.31.1", mac, out, sizeof(out)) == PW_ERR_MALFORMED);
+    assert(pw_net_adapter_value("0.0.0.0", "255.255.255.0", "192.168.31.1", mac, out, sizeof(out)) == PW_ERR_MALFORMED);
+    assert(pw_net_adapter_value("192.168.31", "255.255.255.0", "1.1.1.1", mac, out, sizeof(out)) == PW_ERR_MALFORMED);
+    assert(pw_net_adapter_value("192.168.31.256", "255.255.255.0", "1.1.1.1", mac, out, sizeof(out)) == PW_ERR_MALFORMED);
+    assert(pw_net_adapter_value("192.168.31.1,x", "255.255.255.0", "1.1.1.1", mac, out, sizeof(out)) == PW_ERR_MALFORMED);
+    assert(pw_net_adapter_value("1.2.3.4", "255.255.255.0.0", "1.1.1.1", mac, out, sizeof(out)) == PW_ERR_MALFORMED);
+    assert(pw_net_adapter_value("1.2.3.4", "255.255.255.0", "1..1.1", mac, out, sizeof(out)) == PW_ERR_MALFORMED);
+    assert(pw_net_adapter_value("01.2.3.4", "255.255.255.0", "1.1.1.1", mac, out, sizeof(out)) == PW_ERR_MALFORMED);
+
+    /* A buffer too small, or missing arguments. */
+    assert(pw_net_adapter_value("192.168.31.16", "255.255.255.0", "192.168.31.1", mac, out, 20) == PW_ERR_PRECONDITION);
+    assert(pw_net_adapter_value(NULL, "255.255.255.0", "192.168.31.1", mac, out, sizeof(out)) == PW_ERR_PRECONDITION);
+    assert(pw_net_adapter_value("1.2.3.4", "255.255.255.0", "1.1.1.1", NULL, out, sizeof(out)) == PW_ERR_PRECONDITION);
+}
+
+int main(void)
+{
+    test_value();
+    puts("test_pw_net_adapter: ok");
+    return 0;
+}
